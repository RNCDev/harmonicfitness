#!/bin/sh
# Refuse to push personal context. me/ is ignored by git, but a forced add or an old
# layout (a profile or log at the top level) could still slip it into a commit.
# Every commit being pushed is checked, not only the last one.
# Installed by tools/setup.sh (git config core.hooksPath tools/hooks).
HERE="$(cd "$(dirname "$0")" && pwd)"
ZERO=0000000000000000000000000000000000000000
status=0
while read -r local_ref local_sha remote_ref remote_sha; do
  [ "$local_sha" = "$ZERO" ] && continue   # deleting a remote branch
  if [ "$remote_sha" != "$ZERO" ] && git cat-file -e "$remote_sha^{commit}" 2>/dev/null; then
    "$HERE/check-private.sh" "$remote_sha..$local_sha" || status=1
  else
    # A new branch (or a remote commit we don't have): the commits no remote has yet.
    "$HERE/check-private.sh" "$local_sha" --not --remotes || status=1
  fi
done
exit $status
