#!/bin/sh
# Refuse to push personal context. me/ is ignored by git, but a forced add or an old
# layout (a profile or log at the top level) could still slip it into a commit.
# Installed by tools/setup.sh (git config core.hooksPath tools/hooks).
ZERO=0000000000000000000000000000000000000000
status=0
while read -r local_ref local_sha remote_ref remote_sha; do
  [ "$local_sha" = "$ZERO" ] && continue
  bad="$(git ls-tree -r --name-only "$local_sha" | grep -E '^(me/|log\.md$|knowledge/profile\.md$|knowledge/health\.md$|workouts/)' | head -5)"
  if [ -n "$bad" ]; then
    echo "pre-push: $local_ref contains personal context, which belongs only in me/ (ignored):"
    echo "$bad" | sed 's/^/  /'
    echo "Remove it from the commit (git rm --cached <path>) and push again."
    status=1
  fi
done
exit $status
