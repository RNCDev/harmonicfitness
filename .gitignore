# Your context: profile, health, log, workouts, research, clips. Never pushed with the
# engine; back it up as its own private repo if you like (see README).
me/
# A renamed context folder (me.real/, me.test/ while trying the new-listener flow) is private too;
# me.example/, the template, is part of the engine.
me.*/
!me.example/
.venv/
# uv's cache, kept in the project only inside ChatGPT's Codex sandbox (./harmonicfitness sets it).
.cache/
# The local voice models (./harmonicfitness models); no trailing slash, so a symlink named models is ignored too.
models
.codegraph/
# Railway's SDK for `railway config plan/apply`, installed in .railway/ (npm ci there).
.railway/node_modules/
__pycache__/
.DS_Store

# The judged grid's generated briefs, menus, scripts and lints (docs/eval/README.md).
docs/eval/out/
# Lint-only exports from the eval scripts, written into each invented listener's workouts/.
docs/eval/listeners/*/workouts/
docs/eval/out-before-*/

# The plan ledgers and briefs of superpowers' executing-plans (scratch, per plan).
.superpowers/

# browser walks: screenshots and logs from the Playwright tools
.playwright-mcp/

# the maintainer's local keys for a browser walk (web/qat_key.py reads GEMINI_API_KEY); never committed
/.env
