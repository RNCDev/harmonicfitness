# Your context: profile, health, log, workouts, research, clips. Never pushed with the
# engine; back it up as its own private repo if you like (see README).
me/
# A renamed context folder (me.real/, me.test/ while trying the new-listener flow) is private too;
# me.example/, the template, is part of the engine.
me.*/
!me.example/
.venv/
# uv's cache, kept in the project only inside ChatGPT's Codex sandbox (./harmonicfitness sets it).
.cache/
# The local voice models (./harmonicfitness models); no trailing slash, so a symlink named models is ignored too.
models
.codegraph/
__pycache__/
.DS_Store

# The plan ledgers and briefs of superpowers' executing-plans (scratch, per plan).
.superpowers/

# browser walks: screenshots and logs from the Playwright tools
.playwright-mcp/

# a local key file at the root (nothing reads it now); never committed
/.env

# the script-writing bench (web/bench/): each run holds a copy of the listener's files
.bench/

# The stock coaches' 45-second samples live on the media bucket (coaches/samples.json lists them;
# tools/coachmaker/upload_samples.py uploads them), never in git.
coaches/*/sample.mp3

# The demo listeners (docs/demos/listeners/<slug>/): their files, research, briefs, menus and drafts are kept;
# what the engine makes there (the installed coach, caches, logs, builds) is not. Clips wait in docs/demos/clips/
docs/demos/ready/
# for `demos upload`.
docs/demos/listeners/*/coaches/
docs/demos/listeners/*/workouts/.audio-cache/
docs/demos/listeners/*/workouts/.logs/
docs/demos/listeners/*/workouts/*/Demo *
docs/demos/listeners/*/workouts/*/Ready-made *
docs/demos/listeners/**/*.lock
docs/demos/listeners/**/*.mp3
docs/demos/clips/
