#!/bin/sh
# sweatcast: every command, in the project's own Python environment (.venv).
#
#   ./sweatcast doctor                    # what this computer can do (works before setup)
#   ./sweatcast setup                     # first run: environment, me/, privacy hook, voice model
#   ./sweatcast build <draft> "<name>"    # lint, render and deliver a workout
#   ./sweatcast help                      # every command
#
# Set SWEATCAST_PYTHON to use another interpreter (the tests do).
ROOT="$(cd "$(dirname "$0")" && pwd)"
if [ "$1" = "setup" ]; then
  shift
  exec sh "$ROOT/tools/setup.sh" "$@"   # makes .venv, so it can't need it
fi
if [ "$1" = "doctor" ]; then
  shift
  exec sh "$ROOT/tools/doctor.sh" "$@"  # the readiness check runs before there's an environment too
fi
VENV_PY="$ROOT/.venv/bin/python"
[ -x "$VENV_PY" ] || VENV_PY="$ROOT/.venv/Scripts/python.exe"   # Windows (Git Bash)
PY="${SWEATCAST_PYTHON:-$VENV_PY}"
if [ ! -x "$PY" ]; then
  echo "sweatcast isn't set up on this computer yet: run ./sweatcast setup (or ask Claude Code to \"set me up\")." >&2
  exit 1
fi
exec "$PY" "$ROOT/tools/sweatcast.py" "$@"
